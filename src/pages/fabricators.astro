---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContactForm from "../components/ContactForm.astro";
import { images } from "../assets/images";
import { addOns } from "../data/company";
---

<BaseLayout
  title="Fabricators — Partner With Prominance"
  description="Join Prominance's fabricator network — miter-cut frames, corner cleats, effective drainage and EPDM gaskets, engineered to international standards."
  path="/fabricators/"
  ogImage="/media/full-view.png"
>
  <PageHero eyebrow="For Fabricators" image={images.fullView} imageAlt="A modern white villa with expansive aluminium-framed glazing.">
    Crafting the future of fenestration.
    <Fragment slot="description">
      A comprehensive range of meticulously designed systems, built from premium aluminium profiles and manufactured to
      international standards.
    </Fragment>
  </PageHero>

  <section class="bg-ink py-32 md:py-48">
    <div class="container-frame">
      <p class="label-eyebrow text-champagne" data-reveal="fade">Built for fabrication</p>
      <p class="display-lg mt-10 max-w-5xl" data-scrub-text>
        Miter-cut frames, corner cleats, effective drainage and EPDM gaskets — engineered for durability in harsh conditions.
      </p>
      <p class="mt-12 max-w-xl text-base leading-relaxed text-ivory/60" data-reveal="up">
        Every Prominance system is designed for consistent, repeatable fabrication, with hardware and gaskets tested and
        warrantied across the full product range.
      </p>
    </div>
  </section>

  <section class="bg-ink-soft py-28 md:py-44">
    <div class="container-frame" data-reveal-group>
      <p class="label-eyebrow text-champagne" data-reveal="fade">Add-ons</p>
      <h2 class="display-md mt-6" data-split>Integrations across the range.</h2>
      <div class="mt-16 grid grid-cols-1 gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
        {
          addOns.map((a, i) => (
            <div class="border-t border-ivory/15 pt-6" data-reveal="up">
              <p class="label-eyebrow text-champagne/80">{String(i + 1).padStart(2, "0")}</p>
              <p class="mt-6 font-display text-3xl font-light">{a.name}</p>
              <p class="mt-3 text-sm leading-relaxed text-ivory/60">{a.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-ink py-28 md:py-44">
    <div class="container-frame grid grid-cols-1 gap-16 md:grid-cols-12" data-reveal-group>
      <div class="md:col-span-5">
        <p class="label-eyebrow text-champagne" data-reveal="fade">Partner with us</p>
        <h2 class="display-md mt-6 text-balance" data-split>Join the Prominance fabricator network.</h2>
      </div>
      <div class="md:col-span-7" data-reveal="up">
        <ContactForm cta="Enquire to partner" messageLabel="Tell us about your workshop" />
      </div>
    </div>
  </section>
</BaseLayout>
