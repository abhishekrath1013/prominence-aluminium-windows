---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import ArrowLink from "../../components/ArrowLink.astro";
import StudioInvite from "../../components/StudioInvite.astro";
import { projects } from "../../data/projects";
import { getProduct } from "../../data/products";
import { getSolution } from "../../data/solutions";
import { images } from "../../assets/images";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const product = getProduct(project.system);
const solution = product ? undefined : getSolution(project.system);
const applications = product?.applications ?? solution?.description ?? "";
const systemHref = product ? `/${product.slug}/` : "/facade-sky-lights/";
const systemHeadline = product?.headline ?? solution?.headline ?? "";
---

<BaseLayout
  title={`${project.title} — Prominance Residences`}
  description={`${project.title}, featuring the Prominance ${project.systemName} system.`}
  path={`/projects/${project.slug}/`}
  ogImage={project.image.src}
>
  <PageHero eyebrow={`Residence · ${project.systemName}`} image={project.image} imageAlt={`${project.title} — featuring the ${project.systemName} system.`}>
    {project.title}
    <Fragment slot="description">{systemHeadline}</Fragment>
  </PageHero>

  <section class="bg-ink py-32 md:py-48">
    <div class="container-frame grid grid-cols-1 gap-12 md:grid-cols-12">
      <p class="label-eyebrow text-champagne md:col-span-3" data-reveal="fade">The setting</p>
      <p class="display-md max-w-4xl md:col-span-9" data-scrub-text>{applications}</p>
    </div>
  </section>

  <section class="bg-ink pb-32 md:pb-48">
    <div class="container-frame grid grid-cols-1 gap-8 sm:grid-cols-2">
      <div class="relative aspect-[4/3] overflow-hidden" data-img-reveal>
        <Image src={project.image} alt={`${project.title} detail.`} class="h-[116%] w-full object-cover" data-parallax="0.2" loading="lazy" widths={[500, 900, 1200]} sizes="(min-width: 640px) 50vw, 100vw" />
      </div>
      <div class="relative aspect-[4/3] overflow-hidden" data-img-reveal>
        <Image src={images.led} alt="Detail of an aluminium frame reveal with integrated LED lighting." class="h-[116%] w-full object-cover" data-parallax="0.2" loading="lazy" widths={[500, 900, 1200]} sizes="(min-width: 640px) 50vw, 100vw" />
      </div>
    </div>
  </section>

  <section class="bg-ink-soft py-28 md:py-44">
    <div class="container-frame grid grid-cols-1 gap-12 md:grid-cols-12" data-reveal-group>
      <p class="label-eyebrow text-champagne md:col-span-3" data-reveal="fade">The system</p>
      <div class="md:col-span-9">
        <h2 class="display-lg" data-split>{project.systemName}</h2>
        <p class="mt-8 max-w-xl text-base leading-relaxed text-ivory/65" data-reveal="up">{product?.description ?? solution?.description}</p>
        <div class="mt-10" data-reveal="up"><ArrowLink href={systemHref}>Discover {project.systemName}</ArrowLink></div>
      </div>
    </div>
  </section>

  <StudioInvite />
</BaseLayout>
