---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import StudioInvite from "../../components/StudioInvite.astro";
import { images } from "../../assets/images";
import { projects } from "../../data/projects";
---

<BaseLayout
  title="Residences — Prominance in Architectural Context"
  description="Selected applications of Prominance's aluminium window, door and facade systems across residential and architectural settings."
  path="/projects/"
  ogImage="/media/hero-corner.jpg"
>
  <PageHero eyebrow="Residences" image={images.heroCorner} imageAlt="A concrete villa corner with full-height aluminium-framed glazing opening onto a terrace.">
    Homes designed around a view.
    <Fragment slot="description">
      A closer look at how each Prominance system lives in real architectural settings — from panoramic hillside
      glazing to compact urban interiors.
    </Fragment>
  </PageHero>

  <section class="bg-ink py-28 md:py-44">
    <div class="container-frame grid grid-cols-1 gap-x-10 gap-y-24 md:grid-cols-12">
      {
        projects.map((p, i) => {
          const layout = [
            "md:col-span-8",
            "md:col-span-4 md:mt-40",
            "md:col-span-5 md:col-start-2",
            "md:col-span-6 md:col-start-7 md:mt-24",
            "md:col-span-6",
            "md:col-span-5 md:col-start-8 md:mt-32",
          ][i % 6];
          const ratio = i % 3 === 1 ? "aspect-[3/4]" : "aspect-[4/3]";
          return (
            <a href={`/projects/${p.slug}/`} class={`group block ${layout}`}>
              <div class={`relative overflow-hidden ${ratio}`} data-img-reveal>
                <Image
                  src={p.image}
                  alt={`${p.title} — featuring the ${p.systemName} system.`}
                  class="h-[114%] w-full object-cover transition-transform duration-[1600ms] ease-[var(--ease-lux)] group-hover:scale-[1.04]"
                  data-parallax="0.16"
                  loading="lazy"
                  widths={[500, 900, 1400]}
                  sizes="(min-width: 768px) 55vw, 100vw"
                />
              </div>
              <div class="mt-6 flex items-baseline justify-between gap-6" data-reveal="up">
                <h2 class="font-display text-3xl font-light transition-colors group-hover:text-champagne-soft md:text-4xl">{p.title}</h2>
                <span class="label-eyebrow shrink-0 text-ivory/45">{p.systemName}</span>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

  <StudioInvite />
</BaseLayout>
