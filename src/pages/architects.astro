---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContactForm from "../components/ContactForm.astro";
import { images } from "../assets/images";
---

<BaseLayout
  title="Architects — Specify Prominance"
  description="Technical specification support for architects working with Prominance's aluminium window, door and facade systems."
  path="/architects/"
  ogImage="/media/hero-corner.jpg"
>
  <PageHero eyebrow="For Architects" image={images.heroCorner} imageAlt="A minimal aluminium-framed glass corner opening a concrete villa onto a terrace.">
    Specification support, from first sketch.
    <Fragment slot="description">
      Verified technical data for every Prominance system — frame geometry, glazing capacity and performance ratings —
      ready for your drawings and specifications.
    </Fragment>
  </PageHero>

  <section class="bg-ink py-32 md:py-48">
    <div class="container-frame">
      <p class="label-eyebrow text-champagne" data-reveal="fade">Why specify Prominance</p>
      <p class="display-lg mt-10 max-w-5xl" data-scrub-text>
        Every system is documented to the same standard as the frame itself — precise, verifiable and ready to build on.
      </p>
    </div>
  </section>

  <section class="bg-ink-soft py-28 md:py-44">
    <div class="container-frame grid grid-cols-1 gap-16 md:grid-cols-12" data-reveal-group>
      <div class="md:col-span-5">
        <p class="label-eyebrow text-champagne" data-reveal="fade">Get in touch</p>
        <h2 class="display-md mt-6 text-balance" data-split>Request specifications for your project.</h2>
      </div>
      <div class="md:col-span-7" data-reveal="up">
        <ContactForm cta="Request specifications" messageLabel="Tell us about the project" />
      </div>
    </div>
  </section>
</BaseLayout>
