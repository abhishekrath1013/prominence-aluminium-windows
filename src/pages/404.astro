---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowLink from "../components/ArrowLink.astro";
---

<BaseLayout title="Page Not Found" description="This page could not be found." path="/404/">
  <section class="flex min-h-[100svh] flex-col justify-center bg-ink pt-24">
    <div class="container-frame" data-reveal-group>
      <p class="label-eyebrow text-champagne" data-reveal="fade">404</p>
      <h1 class="display-xl mt-8" data-split>This view <em class="italic text-champagne-soft">doesn’t exist.</em></h1>
      <p class="lead mt-10 max-w-md text-ivory/70" data-reveal="up">The page you were looking for may have moved. Explore the collection or return home.</p>
      <div class="mt-12 flex flex-wrap gap-10" data-reveal="up">
        <ArrowLink href="/">Return home</ArrowLink>
        <ArrowLink href="/products/">The collection</ArrowLink>
      </div>
    </div>
  </section>
</BaseLayout>
