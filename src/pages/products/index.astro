---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import ProductList from "../../components/ProductList.astro";
import StudioInvite from "../../components/StudioInvite.astro";
import { images } from "../../assets/images";
import { products, productFamilies } from "../../data/products";
import { finishes, finishTiers } from "../../data/finishes";
import type { FinishTier } from "../../data/finishes";

const sliding = products.filter((p) => p.family === "sliding");
const casement = products.filter((p) => p.family === "casement");
const tiers = Object.keys(finishTiers) as FinishTier[];
---

<BaseLayout
  title="The Collection — Sliding & Casement Aluminium Systems"
  description="The full Prominance collection: Graf sliding systems and Livio / Robus casement systems, engineered in 6063 T-6 virgin aluminium."
  path="/products/"
  ogImage="/media/villa-2.png"
>
  <PageHero eyebrow="The Collection" image={images.villa2} imageAlt="A cliffside modern villa at dusk with expansive aluminium-framed glass walls.">
    Two platforms. One standard.
    <Fragment slot="description">
      Sliding and casement systems built to the same standard of precision — from residential windows to panoramic,
      all-around concealed glazing.
    </Fragment>
  </PageHero>

  <section id="sliding" class="bg-ink py-28 md:py-44">
    <div class="container-frame" data-reveal-group>
      <p class="label-eyebrow text-champagne" data-reveal="fade">I — Sliding</p>
      <h2 class="display-lg mt-6 max-w-4xl text-balance" data-split>{productFamilies.sliding.description}</h2>
    </div>
    <div class="container-frame mt-24"><ProductList products={sliding} /></div>
  </section>

  <section id="casement" class="bg-ink-soft py-28 md:py-44">
    <div class="container-frame" data-reveal-group>
      <p class="label-eyebrow text-champagne" data-reveal="fade">II — Casement</p>
      <h2 class="display-lg mt-6 max-w-4xl text-balance" data-split>{productFamilies.casement.description}</h2>
    </div>
    <div class="container-frame mt-24"><ProductList products={casement} /></div>
  </section>

  <section id="finishes" class="bg-ink py-28 md:py-44">
    <div class="container-frame" data-reveal-group>
      <p class="label-eyebrow text-champagne" data-reveal="fade">III — Finishes</p>
      <h2 class="display-lg mt-6 max-w-4xl text-balance" data-split>Choose the colour of your light.</h2>
      <p class="mt-8 max-w-lg text-base leading-relaxed text-ivory/65" data-reveal="up">
        Over 100 anodised, powder-coated and metallic finishes are available across every system. Swatches shown are
        a faithful reading of our printed fan chart; we recommend viewing finishes in daylight at the studio.
      </p>
    </div>

    <div class="container-frame mt-24 space-y-24">
      {
        tiers.map((tier) => (
          <div data-reveal-group>
            <div class="flex flex-col gap-3 border-t border-ivory/15 pt-8 md:flex-row md:items-baseline md:justify-between" data-reveal="up">
              <h3 class="font-display text-4xl font-light">{finishTiers[tier].label}</h3>
              <p class="max-w-md text-sm text-ivory/55">{finishTiers[tier].description}</p>
            </div>
            <ul class="mt-10 grid grid-cols-3 gap-x-5 gap-y-10 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8">
              {finishes
                .filter((f) => f.tier === tier)
                .map((f) => (
                  <li data-reveal="up" title={f.description}>
                    <div class="aspect-[3/4] w-full ring-1 ring-ivory/10" style={`background:${f.swatch}`}></div>
                    <p class="mt-3 text-sm">{f.name}</p>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <StudioInvite />
</BaseLayout>
