---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import { company } from "../data/company";

const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(company.mapAddress)}&output=embed`;
---

<BaseLayout
  title="Visit the Experience Studio"
  description="Visit Prominance in Coimbatore — call 1800 102 106, email enquiry@uniframe.com, or request a private visit."
  path="/contact-us/"
>
  <section class="bg-ink pb-16 pt-44 md:pt-56">
    <div class="container-frame" data-reveal-group>
      <p class="label-eyebrow text-champagne" data-reveal="fade">The Experience Studio</p>
      <h1 class="display-xl mt-8 max-w-6xl" data-split>
        Come and see <em class="italic text-champagne-soft">your view.</em>
      </h1>
      <p class="lead mt-12 max-w-xl text-ivory/75" data-reveal="up">
        Whether you are building a villa, renovating a family home, or planning a facade — our team will host you and
        walk you through every system in person.
      </p>
    </div>
  </section>

  <section class="bg-ink py-24 md:py-36">
    <div class="container-frame grid grid-cols-1 gap-20 md:grid-cols-12" data-reveal-group>
      <div class="md:col-span-5">
        <div class="flex flex-col gap-12">
          <div data-reveal="up">
            <p class="label-eyebrow text-champagne">Toll free</p>
            <a href={company.phoneHref} class="mt-3 block font-display text-4xl font-light transition-colors hover:text-champagne-soft">{company.phoneDisplay}</a>
          </div>
          <div data-reveal="up">
            <p class="label-eyebrow text-champagne">Email</p>
            <a href={`mailto:${company.email}`} class="mt-3 block font-display text-3xl font-light transition-colors hover:text-champagne-soft">{company.email}</a>
          </div>
          <div data-reveal="up">
            <p class="label-eyebrow text-champagne">Coimbatore</p>
            <p class="mt-3 max-w-xs text-sm leading-relaxed text-ivory/65">
              {company.legalName}<br />{company.addressLine1}<br />{company.addressLine2}
            </p>
          </div>
        </div>

        <div class="mt-14 aspect-[4/3] w-full overflow-hidden ring-1 ring-ivory/10" data-reveal="up">
          <iframe
            src={mapSrc}
            title="Prominance location on Google Maps"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="h-full w-full grayscale invert-[0.92] contrast-[0.9]"></iframe>
        </div>
      </div>

      <div class="md:col-span-7" data-reveal="up">
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
