---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StudioInvite from "../../components/StudioInvite.astro";
import { insights } from "../../data/insights";
---

<BaseLayout
  title="Journal — Notes on Material, Performance & Design"
  description="Prominance Journal: articles on aluminium window durability, quality and casement window types."
  path="/insights/"
>
  <section class="bg-ink pb-16 pt-44 md:pt-56">
    <div class="container-frame" data-reveal-group>
      <p class="label-eyebrow text-champagne" data-reveal="fade">Journal</p>
      <h1 class="display-lg mt-8 max-w-5xl text-balance" data-split>Notes on material, performance &amp; design.</h1>
    </div>
  </section>

  <section class="bg-ink pb-32 pt-12 md:pb-48">
    <div class="container-frame" data-reveal-group>
      <ul class="border-t border-ivory/15">
        {
          insights.map((post) => (
            <li class="border-b border-ivory/15" data-reveal="up">
              <a href={post.href} target="_blank" rel="noopener noreferrer" class="group flex flex-col gap-4 py-12 md:flex-row md:items-baseline md:justify-between md:gap-12">
                <span class="label-eyebrow w-36 shrink-0 text-champagne">{post.category}</span>
                <span class="font-display text-3xl font-light leading-snug transition-all duration-500 group-hover:translate-x-2 group-hover:text-champagne-soft md:flex-1 md:text-4xl">{post.title}</span>
                <span class="text-xs text-ivory/45">{post.author} · {post.date}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <StudioInvite />
</BaseLayout>
