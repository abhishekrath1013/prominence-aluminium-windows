---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ProductList from "../components/ProductList.astro";
import StudioInvite from "../components/StudioInvite.astro";
import { images } from "../assets/images";
import { products, productFamilies } from "../data/products";

const sliding = products.filter((p) => p.family === "sliding");
---

<BaseLayout
  title="Sliding Systems — The Graf Series"
  description={productFamilies.sliding.description}
  path="/sliding/"
  ogImage="/media/villa.jpeg"
>
  <PageHero eyebrow="Sliding Systems" image={images.villa} imageAlt="A tropical villa with a fully retracted glass sliding wall opening onto an infinity pool.">
    The Graf Series
    <Fragment slot="description">{productFamilies.sliding.description}</Fragment>
  </PageHero>

  <section class="bg-ink py-28 md:py-44">
    <div class="container-frame">
      <ProductList products={sliding} />
    </div>
  </section>

  <StudioInvite />
</BaseLayout>
