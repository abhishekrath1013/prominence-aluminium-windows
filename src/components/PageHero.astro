---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  eyebrow: string;
  image: ImageMetadata;
  imageAlt: string;
}
const { eyebrow, image, imageAlt } = Astro.props;
---

<section class="relative h-[92svh] min-h-[560px] w-full overflow-hidden bg-ink">
  <div class="absolute inset-0 overflow-hidden">
    <Image
      src={image}
      alt={imageAlt}
      class="h-[118%] w-full object-cover"
      data-parallax="0.18"
      fetchpriority="high"
      widths={[640, 1200, 1920]}
      sizes="100vw"
    />
  </div>
  <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/25 to-ink/60"></div>

  <div class="container-frame absolute inset-x-0 bottom-0 pb-16 md:pb-24" data-reveal-group>
    <p class="label-eyebrow text-champagne" data-reveal="fade">{eyebrow}</p>
    <h1 class="display-lg mt-6 max-w-5xl text-balance" data-split data-split-delay="0.15"><slot /></h1>
    <div class="mt-8 max-w-xl text-base leading-relaxed text-ivory/75" data-reveal="up">
      <slot name="description" />
    </div>
  </div>
</section>
