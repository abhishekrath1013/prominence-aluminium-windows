---
interface Props {
  href: string;
  external?: boolean;
}
const { href, external = false } = Astro.props;
---

<a href={href} class="link-underline label-eyebrow" {...external ? { target: "_blank", rel: "noopener noreferrer" } : {}}>
  <slot />
  <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true">
    <path d="M0 5H17M17 5L13 1M17 5L13 9" stroke="currentColor" stroke-width="1"></path>
  </svg>
</a>
