---
import { Image } from "astro:assets";
import { images } from "../assets/images";
import { company, sisterBrands } from "../data/company";
import { footerLinks } from "../data/nav";
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-ink-soft text-ivory">
  <div class="container-frame pb-10 pt-24 md:pt-36">
    <div class="grid grid-cols-1 gap-16 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="label-eyebrow text-champagne" data-reveal="fade">Prominance Your View</p>
        <p class="display-md mt-6 max-w-md" data-reveal="up">Come and stand at the glass.</p>
        <div class="mt-10" data-reveal="up">
          <a href="/contact-us/" class="btn-lux label-eyebrow">Visit the Experience Studio</a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-10 md:col-span-7 md:grid-cols-3">
        <div>
          <p class="label-eyebrow text-champagne">Collection</p>
          <ul class="mt-6 space-y-3 text-sm text-ivory/65">
            {footerLinks.products.map((l) => <li><a href={l.href} class="transition-colors hover:text-ivory">{l.name}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="label-eyebrow text-champagne">House</p>
          <ul class="mt-6 space-y-3 text-sm text-ivory/65">
            {footerLinks.company.map((l) => <li><a href={l.href} class="transition-colors hover:text-ivory">{l.name}</a></li>)}
            <li><a href="/brochure/prominance-brochure.pdf" target="_blank" rel="noopener" class="transition-colors hover:text-ivory">Brochure (PDF)</a></li>
          </ul>
        </div>
        <div class="col-span-2 md:col-span-1">
          <p class="label-eyebrow text-champagne">Private enquiries</p>
          <ul class="mt-6 space-y-3 text-sm text-ivory/65">
            <li><a href={company.phoneHref} class="transition-colors hover:text-ivory">{company.phoneDisplay}</a></li>
            <li><a href={`mailto:${company.email}`} class="transition-colors hover:text-ivory">{company.email}</a></li>
            <li class="leading-relaxed">{company.addressLine1}<br />{company.addressLine2}</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="hairline mt-24"></div>

    <div class="mt-10 flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <a href="/" aria-label="Prominance — home">
        <Image
          src={images.prominanceLogo}
          alt="PROMINANCE"
          width={1060}
          height={198}
          class="h-8 w-auto brightness-0 invert"
          widths={[260, 520]}
          sizes="220px"
          loading="lazy"
        />
      </a>
      <div class="flex flex-wrap gap-x-8 gap-y-3 label-eyebrow text-ivory/55">
        <a href={company.social.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-champagne">Instagram</a>
        <a href={company.social.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-champagne">LinkedIn</a>
        <a href={company.social.youtube} target="_blank" rel="noopener noreferrer" class="hover:text-champagne">YouTube</a>
        <a href={company.social.facebook} target="_blank" rel="noopener noreferrer" class="hover:text-champagne">Facebook</a>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-4 text-xs text-ivory/40 md:flex-row md:justify-between">
      <p>© {year} {company.legalName}. A Uniframe house.</p>
      <p>
        Sister brands:
        {sisterBrands.map((b, i) => (
          <>
            <a href={b.href} target="_blank" rel="noopener noreferrer" class="hover:text-ivory">{b.name}</a>{i < sisterBrands.length - 1 ? " · " : ""}
          </>
        ))}
      </p>
    </div>
  </div>
</footer>
