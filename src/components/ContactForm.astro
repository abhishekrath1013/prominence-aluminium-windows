---
import { company } from "../data/company";
interface Props {
  cta?: string;
  messageLabel?: string;
}
const { cta = "Request a private visit", messageLabel = "Tell us about your home" } = Astro.props;
---

<form class="uf-form" id="uf-contact-form" data-endpoint-email={company.email}>
  <div class="grid grid-cols-1 gap-x-10 gap-y-9 md:grid-cols-2">
    <label class="uf-field">
      <span class="label-eyebrow">Name</span>
      <input type="text" name="name" required autocomplete="name" />
    </label>
    <label class="uf-field">
      <span class="label-eyebrow">Phone</span>
      <input type="tel" name="phone" autocomplete="tel" />
    </label>
    <label class="uf-field md:col-span-2">
      <span class="label-eyebrow">Email</span>
      <input type="email" name="email" required autocomplete="email" />
    </label>
    <label class="uf-field md:col-span-2">
      <span class="label-eyebrow">{messageLabel}</span>
      <textarea name="message" rows="3" required></textarea>
    </label>
  </div>
  <div class="mt-12 flex flex-wrap items-center gap-6">
    <button type="submit" class="btn-lux label-eyebrow">{cta}</button>
    <p class="uf-status text-xs text-ivory/60" role="status" aria-live="polite"></p>
  </div>
</form>

<style>
  .uf-field {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    color: var(--color-ivory);
  }
  .uf-field > span {
    color: var(--color-champagne);
  }
  .uf-field input,
  .uf-field textarea {
    background: transparent;
    border: none;
    border-bottom: 1px solid rgb(241 236 226 / 0.28);
    padding-block: 0.7rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 300;
    color: var(--color-ivory);
    resize: none;
    transition: border-color 0.4s ease;
  }
  .uf-field input:focus,
  .uf-field textarea:focus {
    outline: none;
    border-color: var(--color-champagne);
  }
</style>

<script>
  const form = document.getElementById("uf-contact-form") as HTMLFormElement | null;
  const status = form?.querySelector<HTMLParagraphElement>(".uf-status");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const email = form.dataset.endpointEmail ?? "enquiry@uniframe.com";
    const subject = encodeURIComponent(`Studio visit request — ${d.get("name") ?? "Website"}`);
    const body = encodeURIComponent(
      `Name: ${d.get("name")}\nPhone: ${d.get("phone")}\nEmail: ${d.get("email")}\n\n${d.get("message")}`
    );
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
    if (status) status.textContent = "Opening your email app to send this request…";
  });
</script>
