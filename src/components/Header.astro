---
import { Image } from "astro:assets";
import { images } from "../assets/images";
import { company } from "../data/company";
import { products } from "../data/products";

const primary = [
  { label: "The Collection", href: "/products/" },
  { label: "Residences", href: "/projects/" },
  { label: "Facade & Beyond", href: "/facade-sky-lights/" },
  { label: "Our House", href: "/about-us/" },
  { label: "Journal", href: "/insights/" },
  { label: "Visit the Studio", href: "/contact-us/" },
];
const sliding = products.filter((p) => p.family === "sliding");
const casement = products.filter((p) => p.family === "casement");
---

<header data-header class="uf-header fixed inset-x-0 top-0 z-[150]">
  <div class="uf-header-bar container-frame flex items-center justify-between py-5 md:py-7">
    <a href="/" aria-label="Prominance — home" class="relative z-[2]">
      <Image
        src={images.prominanceLogo}
        alt="PROMINANCE"
        width={1060}
        height={198}
        class="h-6 w-auto brightness-0 invert md:h-7"
        widths={[260, 520]}
        sizes="180px"
      />
    </a>

    <div class="relative z-[2] flex items-center gap-6 md:gap-10">
      <a href="/contact-us/" class="label-eyebrow hidden text-ivory/80 transition-colors hover:text-champagne md:inline">
        Visit the Studio
      </a>
      <button type="button" data-menu-toggle aria-expanded="false" aria-controls="uf-menu" class="group flex items-center gap-4">
        <span class="label-eyebrow" data-menu-label>Menu</span>
        <span class="relative block h-[10px] w-9">
          <span class="absolute left-0 top-0 block h-px w-full bg-ivory transition-transform duration-500 group-aria-expanded:translate-y-[4.5px] group-aria-expanded:rotate-[20deg]"></span>
          <span class="absolute bottom-0 left-0 block h-px w-2/3 bg-ivory transition-all duration-500 group-aria-expanded:bottom-[4.5px] group-aria-expanded:w-full group-aria-expanded:-rotate-[20deg]"></span>
        </span>
      </button>
    </div>
  </div>

  <nav id="uf-menu" class="uf-menu" aria-label="Primary" hidden>
    <div class="container-frame grid h-full grid-cols-1 gap-10 pb-10 pt-28 md:grid-cols-12 md:pt-36">
      <ul class="flex flex-col justify-center gap-1 md:col-span-7">
        {
          primary.map((l, i) => (
            <li class="overflow-hidden">
              <a href={l.href} data-menu-link class="group flex items-baseline gap-5 py-1">
                <span class="label-eyebrow w-7 text-champagne/80">{String(i + 1).padStart(2, "0")}</span>
                <span class="font-display text-[clamp(2.25rem,6.2vw,5.5rem)] font-light leading-[1.02] transition-all duration-500 group-hover:translate-x-3 group-hover:italic group-hover:text-champagne-soft">
                  {l.label}
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="hidden flex-col justify-between md:col-span-5 md:flex" data-menu-extra>
        <div class="grid grid-cols-2 gap-8">
          <div>
            <p class="label-eyebrow text-champagne">Sliding</p>
            <ul class="mt-5 space-y-3">
              {sliding.map((p) => <li><a href={`/${p.slug}/`} class="text-sm text-ivory/70 transition-colors hover:text-ivory">{p.name}</a></li>)}
            </ul>
          </div>
          <div>
            <p class="label-eyebrow text-champagne">Casement</p>
            <ul class="mt-5 space-y-3">
              {casement.map((p) => <li><a href={`/${p.slug}/`} class="text-sm text-ivory/70 transition-colors hover:text-ivory">{p.name}</a></li>)}
            </ul>
          </div>
        </div>
        <div class="text-sm leading-relaxed text-ivory/60">
          <p class="label-eyebrow text-champagne">Private enquiries</p>
          <a href={company.phoneHref} class="mt-3 block font-display text-3xl text-ivory">{company.phoneDisplay}</a>
          <a href={`mailto:${company.email}`} class="mt-1 block hover:text-ivory">{company.email}</a>
        </div>
      </div>
    </div>
  </nav>
</header>

<style>
  .uf-header {
    transition: transform 0.7s var(--ease-lux), background-color 0.5s ease, backdrop-filter 0.5s ease;
  }
  .uf-header.is-solid:not(.is-open) {
    background: rgb(10 10 11 / 0.72);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }
  .uf-header.is-hidden {
    transform: translateY(-110%);
  }
  .uf-menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    background: var(--color-ink);
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition: clip-path 0.9s var(--ease-lux), visibility 0s linear 0.9s;
    overflow-y: auto;
  }
  .uf-header.is-open .uf-menu {
    clip-path: inset(0 0 0% 0);
    visibility: visible;
    transition: clip-path 0.9s var(--ease-lux), visibility 0s;
  }
  [data-menu-link] > span:last-child {
    display: inline-block;
    transform: translateY(105%);
    transition: transform 0.9s var(--ease-lux), color 0.4s, font-style 0.4s;
  }
  .uf-header.is-open [data-menu-link] > span:last-child {
    transform: translateY(0);
  }
  .uf-header.is-open li:nth-child(2) [data-menu-link] > span:last-child { transition-delay: 0.06s; }
  .uf-header.is-open li:nth-child(3) [data-menu-link] > span:last-child { transition-delay: 0.12s; }
  .uf-header.is-open li:nth-child(4) [data-menu-link] > span:last-child { transition-delay: 0.18s; }
  .uf-header.is-open li:nth-child(5) [data-menu-link] > span:last-child { transition-delay: 0.24s; }
  .uf-header.is-open li:nth-child(6) [data-menu-link] > span:last-child { transition-delay: 0.3s; }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.getElementById("uf-menu");
  const label = document.querySelector<HTMLElement>("[data-menu-label]");

  function setOpen(open: boolean) {
    if (!header || !toggle || !menu) return;
    if (open) menu.hidden = false;
    // next frame so the clip-path transition runs
    requestAnimationFrame(() => {
      header.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      if (label) label.textContent = open ? "Close" : "Menu";
      const lenis = (window as any).__lenis;
      if (open) lenis?.stop();
      else lenis?.start();
      document.documentElement.style.overflow = open ? "hidden" : "";
    });
    if (!open) window.setTimeout(() => { if (!header.classList.contains("is-open")) menu.hidden = true; }, 950);
  }

  toggle?.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
  menu?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
</script>
