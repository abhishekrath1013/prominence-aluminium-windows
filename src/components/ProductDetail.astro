---
import { Image } from "astro:assets";
import PageHero from "./PageHero.astro";
import StudioInvite from "./StudioInvite.astro";
import ArrowLink from "./ArrowLink.astro";
import type { Product } from "../data/products";
import { relatedProducts } from "../data/products";

interface Props {
  product: Product;
}
const { product } = Astro.props;
const related = relatedProducts(product.slug, 3);

const specGroups = [
  { title: "Frame", rows: product.frame },
  { title: "Glazing", rows: product.glazing },
  { title: "Sash", rows: product.sash },
  { title: "Performance", rows: product.performance },
];
---

<PageHero
  eyebrow={product.family === "sliding" ? "Sliding System" : "Casement System"}
  image={product.heroImage}
  imageAlt={`${product.fullTitle} — ${product.headline}`}
>
  {product.name}
  <Fragment slot="description">{product.headline}</Fragment>
</PageHero>

<section class="bg-ink py-32 md:py-48">
  <div class="container-frame grid grid-cols-1 gap-12 md:grid-cols-12">
    <p class="label-eyebrow text-champagne md:col-span-3" data-reveal="fade">The system</p>
    <div class="md:col-span-9">
      <p class="display-md max-w-4xl" data-scrub-text>{product.description}</p>
      <p class="mt-14 max-w-xl text-base leading-relaxed text-ivory/60" data-reveal="up">
        <span class="label-eyebrow mr-2 text-champagne">Made for</span>{product.applications}
      </p>
    </div>
  </div>
</section>

<section class="bg-ink pb-32 md:pb-48">
  <div class="container-frame">
    <div class="relative aspect-[16/9] overflow-hidden" data-img-reveal>
      <Image
        src={product.heroImage}
        alt={`${product.fullTitle} in situ.`}
        class="h-[116%] w-full object-cover"
        data-parallax="0.2"
        loading="lazy"
        widths={[640, 1200, 1920]}
        sizes="100vw"
      />
    </div>
  </div>
</section>

<section class="bg-ink-soft py-28 md:py-44">
  <div class="container-frame" data-reveal-group>
    <p class="label-eyebrow text-champagne" data-reveal="fade">Specifications</p>
    <h2 class="display-lg mt-6" data-split>Engineered to the millimetre.</h2>

    <div class="mt-24 grid grid-cols-1 gap-x-12 gap-y-20 md:grid-cols-2">
      {
        specGroups.map((group) => (
          <div data-reveal="up">
            <p class="font-display text-3xl font-light text-champagne-soft">{group.title}</p>
            <dl class="mt-8">
              {group.rows.map((row) => (
                <div class="flex items-baseline justify-between gap-8 border-t border-ivory/12 py-4">
                  <dt class="text-sm text-ivory/55">{row.label}</dt>
                  <dd class="text-right text-sm text-ivory">{row.value}</dd>
                </div>
              ))}
              <div class="border-t border-ivory/12"></div>
            </dl>
          </div>
        ))
      }
    </div>

    <div class="mt-24 grid grid-cols-1 gap-12 border-t border-ivory/12 pt-12 md:grid-cols-2">
      <div data-reveal="up">
        <p class="label-eyebrow text-champagne">Hardware</p>
        <p class="mt-4 text-base leading-relaxed text-ivory/70">{product.hardware}</p>
      </div>
      <div data-reveal="up">
        <p class="label-eyebrow text-champagne">Finishes</p>
        <p class="mt-4 text-base leading-relaxed text-ivory/70">
          Available across the full Prominance palette of 100+ anodised, powder-coated and metallic colours.
          <a href="/products/#finishes" class="ml-1 underline decoration-champagne/50 underline-offset-4 hover:decoration-champagne">View finishes</a>
        </p>
      </div>
    </div>
  </div>
</section>

{
  related.length > 0 && (
    <section class="bg-ink py-28 md:py-44">
      <div class="container-frame" data-reveal-group>
        <p class="label-eyebrow text-champagne" data-reveal="fade">Continue exploring</p>
        <div class="mt-14 grid grid-cols-1 gap-10 sm:grid-cols-3">
          {related.map((p) => (
            <a href={`/${p.slug}/`} class="group block" data-reveal="up">
              <div class="relative aspect-[4/5] overflow-hidden bg-ink-raised">
                <Image
                  src={p.cardImage}
                  alt={p.fullTitle}
                  class="h-full w-full object-cover transition-transform duration-[1400ms] ease-[var(--ease-lux)] group-hover:scale-[1.06]"
                  loading="lazy"
                  widths={[300, 600, 900]}
                  sizes="(min-width: 640px) 33vw, 100vw"
                />
              </div>
              <p class="label-eyebrow mt-6 text-ivory/50">{p.category}</p>
              <p class="mt-2 font-display text-4xl font-light transition-colors group-hover:text-champagne-soft">{p.name}</p>
            </a>
          ))}
        </div>
        <div class="mt-16" data-reveal="up"><ArrowLink href="/products/">The full collection</ArrowLink></div>
      </div>
    </section>
  )
}

<StudioInvite />
