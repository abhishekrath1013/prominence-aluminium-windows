---
import { finishes } from "../data/finishes";
import "./window-scene.css";
// The view outside: Seattle from Kerry Park, 3840 × 2400, aligned on the same landmarks and saved lossless.
// Sources and licences: ../assets/media/window-view/CREDITS.md
// Imported with ?url so the files are served exactly as they are, with no resizing or re-compression.
import viewDay from "../assets/media/window-view/day.webp?url";
import viewMidday from "../assets/media/window-view/midday.webp?url";
import viewEvening from "../assets/media/window-view/evening.webp?url";
import viewNight from "../assets/media/window-view/night.webp?url";

const times = [
  { key: "day", label: "Day", src: viewDay },
  { key: "midday", label: "Midday", src: viewMidday },
  { key: "evening", label: "Evening", src: viewEvening },
  { key: "night", label: "Night", src: viewNight },
];

// A curated set from the real fan chart: matte solids, metallics and wood-grain.
const pick = ["Noir", "Slate", "Urban Mist", "Frost", "Cedar", "Urban Dusk", "Caramel", "Duke", "Citrine", "Royal Chestnut"];
const list = pick.map((n) => finishes.find((f) => f.name === n)!).filter(Boolean);
const data = list.map(({ slug, name, tier, swatch }) => ({ slug, name, tier, swatch }));

// The systems Uniframe lists: Graf sliding, Livio casement + bay, Robus 40 fold & slide,
// Full View glazing and geometrical windows.
const models = [
  { key: "sliding", label: "Sliding", sub: "Graf" },
  { key: "casement", label: "Casement", sub: "Livio" },
  { key: "fold", label: "Fold & Slide", sub: "Robus 40" },
  { key: "bay", label: "Bay", sub: "Livio" },
  { key: "fixed", label: "Full View", sub: "Fixed" },
  { key: "geo", label: "Geometrical", sub: "Hexagon" },
];
---

<section class="cf" data-cfg data-finishes={JSON.stringify(data)}>
  <div class="cf__glow" aria-hidden="true"></div>

  <div class="cf__box">
  <div class="cf__panel">
    <div class="cf__panel-in">
      <p class="label-eyebrow text-champagne" data-reveal="fade">Styles &amp; Customization</p>
      <h2 class="display-md mt-4 text-balance" data-reveal="up">Tailored to your taste.</h2>
      <p class="mt-4 text-sm leading-relaxed text-ivory/65" data-reveal="up">
        No two homes are the same. Mix and match styles, sizes, and finishes to create windows and doors that are a perfect fit for your space.
      </p>

      <div class="mt-7 space-y-5" data-reveal="up">
        <div>
          <p class="label-eyebrow mb-3 text-ivory/50">System · <span class="text-ivory" data-cfg-model-name>Graf · Sliding</span></p>
          <div class="flex flex-wrap gap-2">
            {
              models.map((m, i) => (
                <button type="button" data-cfg-model={m.key} aria-pressed={i === 0 ? "true" : "false"} class="cfg-pill">
                  <span>{m.label}</span><em>{m.sub}</em>
                </button>
              ))
            }
          </div>
        </div>

        <div>
          <p class="label-eyebrow mb-3 text-ivory/50">Finish · <span class="text-ivory" data-cfg-finish-name>Noir</span></p>
          <div class="flex flex-wrap gap-2.5">
            {
              list.map((f, i) => (
                <button type="button" data-cfg-finish={i} aria-pressed="false" aria-label={f.name} title={f.name} class="cfg-swatch" style={`--c:${f.swatch}`}></button>
              ))
            }
          </div>
        </div>

        <div>
          <p class="label-eyebrow mb-3 text-ivory/50">View · <span class="text-ivory" data-cfg-time-name>Day</span></p>
          <div class="cfg-seg" role="group" aria-label="Time of day">
            {times.map((t, i) => <button type="button" data-cfg-time={t.key} aria-pressed={i === 0 ? "true" : "false"}>{t.label}</button>)}
          </div>
        </div>

        <button type="button" data-cfg-open aria-pressed="false" class="cfg-pill"><span data-cfg-open-label>Open window</span></button>
      </div>

      <p class="mt-5 max-w-xs text-xs leading-relaxed text-ivory/45">
        Flick the switch on the wall to turn the lights on. 6063 T-6 virgin aluminium, double glazing, EPDM gaskets — finished in any of 100+ colours.
      </p>
    </div>

  </div>

  <!-- the wrapper does the positioning/centring; the stage inside is animated, so it must carry no CSS translate of its own -->
  <div class="cf__stagewrap">
    <div class="cf__stage">
      <div class="wn" data-wn data-time="day" data-light="off">
        <div class="wn__scene">
          <div class="wn__plaster" aria-hidden="true"></div>
          <div class="wn__lamps" aria-hidden="true"></div>
          <div class="wn__view" data-wn-view aria-hidden="true">
            {/* full-resolution files: only the first loads with the page, the rest when asked for */}
            {times.map((t, i) => <img src={i === 0 ? t.src : undefined} data-src={t.src} data-wn-img={t.key} alt="" width="3840" height="2400" loading="lazy" decoding="async" />)}
          </div>
          <div class="wn__windows" data-wn-windows aria-hidden="true"></div>
          <button type="button" class="wn-switch" data-wn-switch role="switch" aria-checked="false" aria-label="Room lights" title="Room lights">
            <span class="wn-switch__rocker"></span>
            <span class="wn-switch__led"></span>
          </button>
        </div>
      </div>
    </div>
  </div>
  </div>
</section>

<style is:global>
  /* ---- layout: one screen tall; the design's 1326 × 973 stage is scaled to fit it. Panel and 3D window are placed in
          design units (u); the panel's own type is scaled with zoom (--z, set below) so it stays 1:1 with the design ---- */
  .cf {
    container-type: size;
    position: relative;
    overflow: hidden;
    height: 100svh;
    min-height: 520px;
    background: var(--color-ink);
  }
  /* full-width band as tall as the design scaled to fit the screen height; panel pinned left, 3D window centred in the rest */
  .cf__box {
    --u: calc(min(100cqw, 100cqh * 1326 / 973) / 1326);
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    translate: 0 -50%;
    height: calc(973 * var(--u));
  }
  .cf__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 70% 45%, rgba(66, 155, 70, 0.1), transparent 60%);
  }
  .cf__panel {
    position: absolute;
    left: calc(112 * var(--u));
    top: calc(102 * var(--u));
    width: calc(462 * var(--u));
    height: calc(749 * var(--u));
    display: flex;
    align-items: center;
  }
  /* the heading is fixed (not vw-based) so it keeps the design's size and one-line break at any screen width */
  .cf__panel-in .display-md {
    font-family: var(--font-poppins);
    font-weight: 300;
    font-size: 36px;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }
  /* the design's panel type runs 1.115 × the site's base sizes */
  .cf__panel-in {
    zoom: calc(var(--z, 1) * 1.115);
    width: calc(462px / 1.115);
    padding-left: calc(21px / 1.115);
    padding-right: calc(20px / 1.115);
  }
  /* the window wall: as large as the space right of the panel allows (up to 940u wide), centred in it */
  .cf__stagewrap {
    position: absolute;
    left: calc(574 * var(--u));
    right: calc(113 * var(--u));
    top: 0;
    bottom: 0;
    display: grid;
    place-items: center;
  }
  .cf__stage {
    position: relative;
    width: min(940 * var(--u), 100%);
  }
  @media (max-width: 860px) {
    .cf {
      container-type: normal;
      height: auto;
      min-height: 0;
    }
    .cf__box {
      position: relative;
      left: auto;
      right: auto;
      top: auto;
      translate: none;
      height: auto;
      display: grid;
      gap: 2rem;
      padding: 6rem 1.25rem 4rem;
    }
    .cf__panel,
    .cf__stagewrap,
    .cf__stage {
      position: relative;
      left: auto;
      right: auto;
      top: auto;
      bottom: auto;
      translate: none;
      margin-inline: 0;
      width: auto;
      height: auto;
    }
    .cf__stagewrap {
      display: block;
    }
    /* the wall has no intrinsic width (it is a size container), so state it */
    .cf__stage {
      width: 100%;
    }
    .cf__panel-in {
      zoom: 1;
      width: auto;
      padding: 0;
    }
  }

  .cfg-pill {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    padding: 0.7rem 1.1rem;
    border: 1px solid rgb(241 236 226 / 0.28);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ivory);
    transition: background-color 0.4s ease, color 0.4s ease, border-color 0.4s ease;
  }
  .cfg-pill em {
    font-style: normal;
    opacity: 0.5;
    font-size: 0.68rem;
  }
  .cfg-pill:hover {
    border-color: var(--color-champagne);
  }
  .cfg-pill[aria-pressed="true"] {
    background: var(--color-champagne);
    border-color: var(--color-champagne);
    color: var(--color-ink);
  }
  .cfg-swatch {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: var(--c);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.18);
    outline: 1px solid transparent;
    outline-offset: 3px;
    transition: outline-color 0.3s ease, transform 0.4s var(--ease-lux);
  }
  .cfg-swatch:hover {
    transform: scale(1.1);
  }
  .cfg-swatch[aria-pressed="true"] {
    outline-color: var(--color-champagne);
  }
  .cfg-seg {
    display: inline-flex;
    border: 1px solid rgb(241 236 226 / 0.28);
  }
  .cfg-seg button {
    padding: 0.7rem 0.85rem;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ivory);
    transition: background-color 0.4s ease, color 0.4s ease;
  }
  .cfg-seg button[aria-pressed="true"] {
    background: var(--color-ivory);
    color: var(--color-ink);
  }
  .cfg-pill:disabled {
    opacity: 0.35;
    pointer-events: none;
  }
</style>

<script>
  import { mountConfigurator } from "../animations/configurator";
  const root = document.querySelector<HTMLElement>("[data-cfg]");
  if (root) mountConfigurator(root, JSON.parse(root.dataset.finishes ?? "[]"));
</script>

<script>
  const cf = document.querySelector<HTMLElement>(".cf");
  if (cf) {
    // panel type scale = the design scale that fits the screen height (same as --u, in px)
    const scale = () => cf.style.setProperty("--z", (Math.min(cf.clientWidth, (cf.clientHeight * 1326) / 973) / 1326).toFixed(4));
    scale();
    if ("ResizeObserver" in window) new ResizeObserver(scale).observe(cf);
    else addEventListener("resize", scale);
  }
</script>
