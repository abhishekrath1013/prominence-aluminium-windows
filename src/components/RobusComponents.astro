---
// "Inside the frame" — Robus 40 component showcase.
// Idle: a straight-on photo of the whole window with clear glass. "View components" moves it to the right (never
// zoomed), frosts the frame around the chosen part so it shows through, and shows that part in slowly moving 3D on
// the left with its description. Behaviour: src/animations/robus-components.ts + part-viewer.ts.
// Window images: tools/render_robus40.py + tools/compose_robus40.mjs.
import { robusComponents as comps } from "../data/robus-components";
import layout from "../data/robus40-layout.json";

const pad = (n: number) => String(n).padStart(2, "0");
const total = comps.length;
const media = "/media/robus40";

const W = layout.width;
const H = layout.height;
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
const parts = comps.map((c) => {
  const info = layout.parts[c.id as keyof typeof layout.parts];
  const [x, y, w, h] = info.where;
  // the frosted patch around the part, a little larger than the part itself (image pixels)
  const m = 34;
  // where its dot sits: the middle of the part (the gasket runs the full height, so a point well clear of the others)
  const dot = [x + w / 2, y + h * (c.id === "gasket" ? 0.62 : 0.5)];
  return {
    ...c,
    shot: info.shot,
    box: `left:${pct(x, W)};top:${pct(y, H)};width:${pct(w, W)};height:${pct(h, H)}`,
    veil: `left:${pct(x - m, W)};top:${pct(y - m, H)};width:${pct(w + 2 * m, W)};height:${pct(h + 2 * m, H)}`,
    dot: `left:${pct(dot[0], W)};top:${pct(dot[1], H)}`,
  };
});
---

<section
  class="rx"
  id="components"
  data-rx
  data-state="idle"
  aria-labelledby="rx-title"
  data-comps={JSON.stringify(comps)}
>
  <div class="rx-bg" aria-hidden="true"></div>

  <!-- the window photo, always shown whole -->
  <div class="rx-win" data-rx-win>
    <img class="rx-photo" src={`${media}/window.webp`} width={W} height={H} loading="lazy" decoding="async" alt="Robus 40 casement window with a black powder-coated aluminium frame and clear glass" />
    {
      parts.map((p) => (
        <div class="rx-spot" data-rx-spot={p.id} aria-hidden="true">
          <i class="rx-veil" style={p.veil} />
          <img class="rx-where" style={p.box} src={`${media}/where-${p.id}.webp`} loading="lazy" decoding="async" alt="" />
          <i class="rx-mark" style={p.dot} />
        </div>
      ))
    }
    {parts.map((p, i) => <button type="button" class="rx-dot" data-rx-dot={i} style={p.dot} aria-label={`View ${p.name}`} title={p.name} />)}
  </div>

  <!-- where the window is placed: full-width & centred while idle, right half once opened -->
  <div class="rx-vp-frame" data-rx-vp-frame aria-hidden="true"></div>

  <!-- ===== idle ===== -->
  <div class="rx-intro">
    <div class="container-frame rx-intro-grid">
      <div class="rx-intro-copy">
        <p class="label-eyebrow text-champagne">Under the hood</p>
        <h2 id="rx-title" class="display-md mt-4 text-balance">Little details make a massive difference.</h2>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-ivory/60">
          Smooth movement, precise alignment, and that satisfying click when you close. Take a peek at the components working smartly behind the scenes to make every day effortless for you.
        </p>
      </div>

      <ol class="rx-index">
        {
          comps.map((c, i) => (
            <li>
              <button type="button" data-rx-pick={i} aria-label={`View ${c.name}`}>
                <span>{pad(i + 1)}</span>
                {c.name}
              </button>
            </li>
          ))
        }
      </ol>

      <div class="rx-intro-cta">
        <button type="button" class="btn-lux label-eyebrow" data-rx-open>
          <span>View components</span>
          <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4" stroke="currentColor" stroke-width="1"></path></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- ===== opened ===== -->
  <div class="rx-panel" aria-live="polite">
    <div class="rx-panel-inner">
      <div class="rx-bar">
        <button type="button" class="rx-back label-eyebrow" data-rx-close>
          <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M18 5H2M6 1L2 5l4 4" stroke="currentColor" stroke-width="1"></path></svg>
          <span>Full window</span>
        </button>
        <div class="rx-pager">
          <p class="label-eyebrow text-ivory/55"><span class="text-champagne" data-rx-count>01</span> / {pad(total)}</p>
          <button type="button" class="rx-ico" data-rx-prev aria-label="Previous component">
            <svg width="16" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M18 5H2M6 1L2 5l4 4" stroke="currentColor" stroke-width="1.2"></path></svg>
          </button>
          <button type="button" class="rx-ico" data-rx-next aria-label="Next component">
            <svg width="16" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4" stroke="currentColor" stroke-width="1.2"></path></svg>
          </button>
        </div>
      </div>

      <!-- title row (one per component) -->
      <div class="rx-heads">
        {
          comps.map((c, i) => (
            <div data-rx-item={i} hidden={i !== 0} class="rx-head">
              <p class="label-eyebrow text-champagne">{c.kicker}</p>
              <h3 class="rx-name">{c.name}</h3>
            </div>
          ))
        }
      </div>

      <!-- the part in 3D (its still photo appears only if 3D can't start) -->
      <div class="rx-stage" data-rx-stage>
        <div class="rx-model" data-rx-model>
          <div class="rx-3d" data-rx-3d role="img" aria-label="3D view of the selected component"></div>
          {
            parts.map((p, i) => (
              <img data-rx-still={i} hidden src={`${media}/part-${p.id}.webp`} width={p.shot[0]} height={p.shot[1]} loading="lazy" decoding="async" alt={p.name} />
            ))
          }
        </div>
        <p class="rx-hint label-eyebrow" data-rx-hint>Drag to turn</p>
      </div>

      <!-- description (one per component) -->
      <div class="rx-bodies">
        {
          comps.map((c, i) => (
            <article data-rx-item={i} hidden={i !== 0} class="rx-body">
              <p class="rx-desc">{c.description}</p>
            </article>
          ))
        }
      </div>

      <nav class="rx-chips" aria-label="Components">
        {
          comps.map((c, i) => (
            <button type="button" class="rx-chip" data-rx-chip={i} aria-label={c.name} title={c.name} aria-current={i === 0 ? "true" : "false"}>
              {pad(i + 1)}
            </button>
          ))
        }
      </nav>
    </div>
  </div>

</section>

<style is:global>
  .rx {
    --rx-ease: var(--ease-lux);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-ink);
    height: 100svh;
    min-height: 560px;
  }

  /* ---------- atmosphere ---------- */
  .rx-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(180deg, #0a0a0b 0%, #101012 55%, #0a0a0b 100%);
  }
  .rx-bg::before,
  .rx-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    transition: opacity 1.1s var(--rx-ease);
  }
  .rx-bg::before {
    background:
      radial-gradient(ellipse 34% 64% at 50% 52%, rgba(66, 155, 70, 0.2), transparent 70%),
      radial-gradient(ellipse 60% 26% at 50% 94%, rgba(66, 155, 70, 0.09), transparent 70%);
  }
  .rx-bg::after {
    opacity: 0;
    background:
      radial-gradient(ellipse 30% 56% at 75% 50%, rgba(66, 155, 70, 0.18), transparent 70%),
      radial-gradient(ellipse 28% 50% at 25% 46%, rgba(255, 255, 255, 0.05), transparent 70%);
  }
  .rx[data-state="open"] .rx-bg::before {
    opacity: 0;
  }
  .rx[data-state="open"] .rx-bg::after {
    opacity: 1;
  }

  /* ---------- the window photo ---------- */
  /* sized and placed by the script in real pixels (not scaled with a transform), so it stays sharp.
     --s is the number of screen pixels per image pixel */
  .rx-win {
    --s: 0.16;
    position: absolute;
    z-index: 1;
    left: 0;
    top: 0;
    visibility: hidden;
  }
  .rx-win[data-placed] {
    visibility: visible;
  }
  /* the shadow the frame throws; inset to the frame's outline inside the picture */
  .rx-win::before {
    content: "";
    position: absolute;
    inset: 1.5% 2.4%;
    box-shadow: 0 calc(var(--s) * 110px) calc(var(--s) * 260px) rgb(0 0 0 / 0.7);
  }
  .rx-photo {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    user-select: none;
    -webkit-user-drag: none;
  }
  .rx-spot {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .rx-spot.is-on {
    opacity: 1;
    transition-duration: 0.9s;
  }
  /* the frame turns to frosted glass around the part */
  .rx-veil {
    position: absolute;
    border-radius: calc(var(--s) * 40px);
    background: rgb(222 230 234 / 0.74);
    box-shadow: 0 0 calc(var(--s) * 55px) calc(var(--s) * 22px) rgb(222 230 234 / 0.62);
  }
  /* the part keeps its real finish; only its outline is brand green */
  .rx-where {
    position: absolute;
    max-width: none;
    filter: drop-shadow(0 0 1px #2f8a35) drop-shadow(0 0 1px #2f8a35) drop-shadow(0 0 5px rgb(66 155 70 / 0.65));
  }
  .rx-mark {
    position: absolute;
    width: 46px;
    height: 46px;
    translate: -50% -50%;
    border: 2px solid #6fd674;
    border-radius: 999px;
    box-shadow: 0 0 10px rgb(66 155 70 / 0.8), inset 0 0 8px rgb(66 155 70 / 0.5);
  }
  .rx-mark::after {
    content: "";
    position: absolute;
    inset: -2px;
    border: 1.5px solid #6fd674;
    border-radius: inherit;
    animation: rx-ping 1.8s ease-out infinite;
  }
  @keyframes rx-ping {
    from {
      scale: 1;
      opacity: 0.9;
    }
    to {
      scale: 1.9;
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rx-mark::after {
      display: none;
    }
  }
  .rx-dot {
    position: absolute;
    width: 26px;
    height: 26px;
    translate: -50% -50%;
    border-radius: 999px;
    cursor: pointer;
    transition: opacity 0.4s ease, visibility 0.4s;
  }
  .rx-dot::before {
    content: "";
    position: absolute;
    inset: 8px;
    border-radius: inherit;
    background: #5fbf63;
    box-shadow: 0 0 0 1.5px rgb(255 255 255 / 0.9), 0 1px 5px rgb(0 0 0 / 0.55);
    transition: scale 0.3s var(--rx-ease);
  }
  .rx-dot:hover::before,
  .rx-dot:focus-visible::before {
    scale: 1.4;
  }
  .rx[data-state="open"] .rx-dot::before {
    opacity: 0.7;
    inset: 9px;
  }
  .rx[data-state="open"] .rx-dot.is-current {
    visibility: hidden;
  }

  /* ---------- where the window is placed (measured by the script) ---------- */
  .rx-vp-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 7%;
    bottom: 16%;
    visibility: hidden;
    pointer-events: none;
  }
  .rx[data-state="open"] .rx-vp-frame {
    left: 50%;
    right: 0;
    top: clamp(92px, 11svh, 124px);
    bottom: clamp(24px, 5svh, 56px);
  }

  /* ---------- idle copy ---------- */
  .rx-intro {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    transition: opacity 0.7s ease, visibility 0.7s;
  }
  .rx[data-state="open"] .rx-intro {
    opacity: 0;
    visibility: hidden;
  }
  .rx-intro-grid {
    position: relative;
    height: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-rows: 1fr auto;
    align-items: center;
    padding-top: clamp(96px, 12svh, 132px);
    padding-bottom: clamp(28px, 5svh, 56px);
  }
  .rx-intro-copy {
    grid-column: 1;
    grid-row: 1;
    max-width: 24rem;
  }
  .rx-index {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: rgb(241 236 226 / 0.5);
  }
  .rx-index li {
    border-bottom: 1px solid rgb(241 236 226 / 0.08);
    min-width: 15rem;
  }
  .rx-index button {
    display: flex;
    width: 100%;
    gap: 1rem;
    align-items: baseline;
    padding: 0.3rem 0 0.55rem;
    text-align: left;
    color: inherit;
    cursor: pointer;
    pointer-events: auto;
    transition: color 0.3s ease, transform 0.4s var(--rx-ease);
  }
  .rx-index button:hover,
  .rx-index button:focus-visible {
    color: var(--color-ivory);
    transform: translateX(-4px);
  }
  .rx-index span {
    font-family: var(--font-poppins);
    font-size: 0.95rem;
    color: var(--color-champagne);
    width: 1.6rem;
  }
  .rx-intro-cta {
    grid-column: 1 / -1;
    grid-row: 2;
    justify-self: center;
    text-align: center;
    pointer-events: auto;
  }

  /* ---------- opened panel ---------- */
  .rx-panel {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 50%;
    z-index: 3;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.5s ease, visibility 0.5s;
  }
  .rx[data-state="open"] .rx-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.9s ease 0.55s, visibility 0s 0.55s;
  }
  .rx-panel::after {
    content: "";
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(to bottom, transparent, rgb(241 236 226 / 0.16) 20%, rgb(241 236 226 / 0.16) 80%, transparent);
  }
  .rx-panel-inner {
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: clamp(92px, 11svh, 124px) clamp(1rem, 3vw, 3.5rem) clamp(24px, 4svh, 44px) var(--gutter);
  }
  .rx-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgb(241 236 226 / 0.12);
  }
  .rx-back {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: rgb(241 236 226 / 0.7);
    transition: color 0.3s ease;
  }
  .rx-back:hover {
    color: var(--color-ivory);
  }
  .rx-pager {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .rx-ico {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid rgb(241 236 226 / 0.25);
    border-radius: 999px;
    color: var(--color-ivory);
    transition: background-color 0.35s ease, border-color 0.35s ease, color 0.35s ease;
  }
  .rx-ico:hover {
    background: var(--color-champagne);
    border-color: var(--color-champagne);
    color: var(--color-ink);
  }
  .rx-heads {
    padding-top: clamp(0.9rem, 2.2svh, 1.5rem);
  }
  /* every component's text is stacked in one grid cell, so the panel is always as tall as the
     longest one and nothing jumps when you step between components */
  .rx-heads,
  .rx-bodies {
    display: grid;
  }
  .rx-heads > *,
  .rx-bodies > * {
    grid-area: 1 / 1;
  }
  .rx-heads > [hidden],
  .rx-bodies > [hidden] {
    display: block;
    visibility: hidden;
  }
  .rx-name,
  #rx-title {
    font-family: var(--font-poppins);
    font-weight: 300;
    font-size: clamp(2rem, 3.1vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }
  .rx-name {
    margin-top: 0.5rem;
  }
  .rx-stage {
    position: relative;
    flex: 1 1 0;
    min-height: 120px;
    margin: clamp(0.4rem, 1.5svh, 1rem) 0;
  }
  /* a soft pool of light so the dark fittings stand clear of the background */
  .rx-stage::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 46% 48% at 50% 50%, rgb(255 255 255 / 0.09), transparent 72%);
  }
  .rx-model,
  .rx-3d {
    position: absolute;
    inset: 0;
  }
  .rx-3d[hidden],
  .rx-hint[hidden] {
    display: none;
  }
  .rx-3d canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
    /* a sideways swipe turns the part; up and down still scrolls the page */
    touch-action: pan-y;
    filter: drop-shadow(0 18px 22px rgb(0 0 0 / 0.45));
  }
  .rx-3d canvas.is-drag {
    cursor: grabbing;
  }
  .rx-model img {
    position: absolute;
    inset: 4%;
    width: 92%;
    height: 92%;
    object-fit: contain;
  }
  .rx-hint {
    position: absolute;
    right: 0;
    bottom: 0;
    color: rgb(241 236 226 / 0.35);
    pointer-events: none;
  }
  .rx-desc {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(1.2rem, 1.7vw, 1.6rem);
    line-height: 1.32;
    color: rgb(241 236 226 / 0.9);
    max-width: 34rem;
  }
  .rx-chips {
    padding-top: clamp(1rem, 2.4svh, 1.6rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .rx-chip {
    min-width: 2.5rem;
    height: 2.1rem;
    padding: 0 0.7rem;
    border: 1px solid rgb(241 236 226 / 0.2);
    border-radius: 999px;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: rgb(241 236 226 / 0.6);
    transition: all 0.35s ease;
  }
  .rx-chip:hover {
    border-color: rgb(241 236 226 / 0.55);
    color: var(--color-ivory);
  }
  .rx-chip[aria-current="true"] {
    background: var(--color-champagne);
    border-color: var(--color-champagne);
    color: var(--color-ink);
  }

  /* ---------- tablet / phone: window on top, part below, description under that ---------- */
  @media (max-width: 1023px) {
    /* leave the heading and paragraph clear above the window */
    .rx-vp-frame {
      top: clamp(300px, 38svh, 420px);
      bottom: 17%;
    }
    .rx[data-state="open"] .rx-vp-frame {
      left: 0;
      right: 0;
      top: 76px;
      bottom: auto;
      height: calc(40svh - 84px);
    }
    .rx-panel::after {
      display: none;
    }
    .rx-mark {
      width: 30px;
      height: 30px;
    }
    .rx[data-state="open"] .rx-dot {
      opacity: 0;
      visibility: hidden;
    }
    .rx-hint {
      display: none;
    }
    .rx-intro-grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr auto;
      align-items: start;
    }
    .rx-intro-copy {
      grid-row: 1;
      max-width: 30rem;
    }
    .rx-index {
      display: none;
    }
    .rx-intro-cta {
      grid-row: 3;
    }
    .rx-panel {
      right: 0;
      top: 40svh;
    }
    .rx-panel-inner {
      padding: 0.75rem var(--gutter) 1.25rem;
    }
    .rx-bar {
      padding-bottom: 0.6rem;
    }
    .rx-heads {
      padding-top: 0.6rem;
    }
    .rx-name {
      font-size: clamp(1.6rem, 6vw, 2.2rem);
    }
    .rx-desc {
      font-size: 1.05rem;
    }
  }
</style>

<script>
  import { mountRobusComponents } from "../animations/robus-components";
  const root = document.querySelector<HTMLElement>("[data-rx]");
  if (root) mountRobusComponents(root);
</script>
