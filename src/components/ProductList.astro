---
import { Image } from "astro:assets";
import type { Product } from "../data/products";

interface Props {
  products: Product[];
}
const { products: items } = Astro.props;
---

<div class="flex flex-col gap-28 md:gap-44">
  {
    items.map((product, i) => (
      <a href={`/${product.slug}/`} class="group grid grid-cols-1 items-center gap-10 md:grid-cols-12 md:gap-16" data-reveal-group>
        <div class={`md:col-span-7 ${i % 2 === 1 ? "md:order-2" : ""}`}>
          <div class="relative aspect-[4/3] w-full overflow-hidden" data-img-reveal>
            <Image
              src={product.cardImage}
              alt={`${product.fullTitle} — ${product.headline}`}
              class="h-[114%] w-full object-cover transition-transform duration-[1600ms] ease-[var(--ease-lux)] group-hover:scale-[1.04]"
              data-parallax="0.16"
              loading="lazy"
              widths={[500, 900, 1400]}
              sizes="(min-width: 768px) 58vw, 100vw"
            />
          </div>
        </div>

        <div class={`md:col-span-5 ${i % 2 === 1 ? "md:order-1" : ""}`}>
          <p class="label-eyebrow text-champagne" data-reveal="fade">{product.category}</p>
          <h3 class="display-lg mt-5 transition-colors duration-500 group-hover:text-champagne-soft" data-split>{product.name}</h3>
          <p class="lead mt-6 max-w-sm text-ivory/75" data-reveal="up">{product.headline}</p>
          <p class="mt-6 max-w-sm text-sm leading-relaxed text-ivory/55" data-reveal="up">{product.applications}</p>
          <span class="link-underline label-eyebrow mt-10" data-reveal="up">
            Discover
            <svg width="18" height="10" viewBox="0 0 18 10" fill="none" class="transition-transform duration-500 group-hover:translate-x-1">
              <path d="M0 5H17M17 5L13 1M17 5L13 9" stroke="currentColor" stroke-width="1" />
            </svg>
          </span>
        </div>
      </a>
    ))
  }
</div>
